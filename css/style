.dropdown {
    color: rgb(20, 108, 148);
    position: absolute;
    display: none;
    background-color: rgb(246, 241, 241);
    z-index: 5;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    padding: 25%;
}
