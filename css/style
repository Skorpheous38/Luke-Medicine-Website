#side_panel::-webkit-scrollbar-thumb {
    background: var(--color-accent);
    border-radius: 4px;
}
 
.aside_title {
    color: var(--color-accent);
    font-size: 15px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-accent);
}
 
.aside_item {
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
}
 
.aside_item:last-child {
    border-bottom: none;
    margin-bottom: 0;
}
 
.aside_item p {
    color: var(--color-muted-text);
    font-size: 13px;
    line-height: 1.5;
    margin-top: 5px;
}
 
/* Tag badges */
.aside_tag {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-light-text);
    background-color: var(--color-card-bg);
}
 
.aside_tag.new      { background-color: #27ae60; }
.aside_tag.event    { background-color: #2980b9; }
.aside_tag.reminder { background-color: #8e44ad; }
.aside_tag.alert    { background-color: var(--color-accent); }
 
/* =====================================================================
   RESPONSIVE — stack on smaller screens
   ===================================================================== */
 
@media (max-width: 900px) {
    #slideshow_layout {
        flex-direction: column;
        align-items: center;
    }
 
    #slide_show,
    #side_panel {
        width: 100%;
        max-width: 600px;
    }
 
    #side_panel {
        height: auto;
    }
}

